{
  "_version": "1.73.1",
  "sap.app": {
    "id": "loyaltyhub",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.20.0",
      "toolsId": "d752eb25-e175-4603-be62-6cc47f8aaf16"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zloyaltyhub_manage_sb/srvd/sap/zloyaltyhub_manage_sd/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "LoyaltyHub-Manage": {
          "semanticObject": "LoyaltyHub",
          "action": "Manage",
          "title": "{{LoyaltyHub-Manage.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.136.11",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "loyaltyhub.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "BusinessPartnerList",
          "target": "BusinessPartnerList"
        },
        {
          "pattern": "BusinessPartner({key}):?query:",
          "name": "BusinessPartnerObjectPage",
          "target": "BusinessPartnerObjectPage"
        }
      ],
      "targets": {
        "BusinessPartnerList": {
          "type": "Component",
          "id": "BusinessPartnerList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/BusinessPartner",
              "variantManagement": "Page",
              "navigation": {
                "BusinessPartner": {
                  "detail": {
                    "route": "BusinessPartnerObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "BusinessPartnerObjectPage": {
          "type": "Component",
          "id": "BusinessPartnerObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/BusinessPartner",
              "controlConfiguration": {
                "_Category/@com.sap.vocabularies.UI.v1.LineItem": {
                  "actions": {
                    "createCategoryUi": {
                      "press": "loyaltyhub.ext.controller.controller.fnCreateCategoryDialog",
                      "visible": "{= ${ui>/editMode} === 'Editable' === true }",
                      "enabled": true,
                      "requiresSelection": false,
                      "text": "Create",
                      "position": {
                        "placement": "Before",
                        "anchor": "DataFieldForAction::com.sap.gateway.srvd.zloyaltyhub_manage_sd.v0001.createMemCategory::Collection::com.sap.gateway.srvd.zloyaltyhub_manage_sd.v0001.CategoryType"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
