    "SOURCE":"@Metadata.layer: #CORE\r\n@UI.headerInfo: {\r\n  typeName:       'Transaction',\r\n  typeNamePlural: 'Transactions',\r\n  title:          { type: #STANDARD, value: 'TransactionId' },\r\n  description:    { type: #STANDARD, value: 'TransactionId' }\r\n}\r\n@UI.presentationVariant: [\r\n  {\r\n\r\n    sortOrder: [\r\n      {\r\n        by: 'TransactionId',\r\n        direction: #DESC\r\n      }\r\n    ],\r\n    visualizations: [{type: #AS_LINEITEM }]\r\n  }\r\n]\r\nannotate view ZLH_C_TRANSACTIONS with\r\n{\r\n  @UI.facet: [\r\n             { type: #IDENTIFICATION_REFERENCE,\r\n               purpose: #STANDARD,\r\n               label : 'Transactions',\r\n               id: 'Transactions' ,\r\n               position: 20 }\r\n               ]\r\n  @UI: { lineItem:       [ { label: 'Transaction ID', position: 10, importance: #HIGH } ] ,\r\n          identification: [{ label: 'Transaction ID', position: 10 }]  }\r\n  @EndUserText: { label: 'Transaction ID', quickInfo: 'Transaction ID' }\r\n\r\n  TransactionId;\r\n  @UI.hidden: true\r\n  BusinessPartner;\r\n  @UI.hidden: true\r\n  Membershipid;\r\n\r\n  @UI: { lineItem: [ {\r\n            label: 'Sales Order',\r\n            position: 20,\r\n            importance: #HIGH,\r\n            type: #WITH_INTENT_BASED_NAVIGATION,\r\n            semanticObject: 'SalesOrder',\r\n            semanticObjectAction: 'manageV2',\r\n            semanticObjectBinding: [{localElement: 'RefSalesorderId', element: 'SalesOrder'}]\r\n          } ],\r\n            identification: [{ label: 'Sales Order', position: 20 }]  }\r\n\r\n  RefSalesorderId;\r\n\r\n  @UI: { lineItem:       [ { label: 'Transaction Date', position: 40, importance: #HIGH } ] ,\r\n          identification: [{ label: 'Transaction Date', position: 40 }]  }\r\n  @EndUserText: { label: 'Transaction Date', quickInfo: 'Transaction Date' }\r\n\r\n  TransactionDate;\r\n\r\n  @UI: { lineItem:       [ { label: 'Activity Type', position: 30, importance: #HIGH } ] ,\r\n          identification: [{ label: 'Activity Type', position: 30 }]  }\r\n  @EndUserText: { label: 'Activity Type', quickInfo: 'Activity Type' }\r\n\r\n  @Consumption.valueHelpDefinition: [{\r\n  entity: { name: 'ZLH_I_ACTTYPEVH', element: 'value_low' },\r\n  label: 'Activity Type'\r\n                              }]\r\n\r\n  ActivityType;\r\n  @UI: { lineItem:       [ { label: 'Amount', position: 50, importance: #HIGH } ] ,\r\n          identification: [{ label: 'Amount', position: 50 }]  }\r\n  @EndUserText: { label: 'Amount', quickInfo: 'Amount' }\r\n\r\n  TransactionAmount;\r\n\r\n\r\n  @UI.hidden: true\r\n  @Consumption.valueHelpDefinition: [{\r\n      entity: { name: 'I_Currency', element: 'Currency' },\r\n     label: 'Currency'\r\n                              }]\r\n  TransactionCurrency;\r\n//  @UI: { lineItem:       [ { label: 'Loyalty Points', position: 60, importance: #HIGH , criticality: 'ActivityCriticality', criticalityRepresentation: #WITHOUT_ICON } ] ,\r\n//          identification: [{ label: 'Loyalty Points', position: 60 }]  }\r\n//  @EndUserText: { label: 'Loyalty Points', quickInfo: 'Loyalty Points' }\r\n@UI.hidden: true\r\n  FormatedLoyaltyPoints;\r\n  @UI: { lineItem:       [ { label: 'Loyalty Points', position: 60, importance: #HIGH , criticality: 'ActivityCriticality', criticalityRepresentation: #WITHOUT_ICON } ] ,\r\n          identification: [{ label: 'Loyalty Points', position: 60 }]  }\r\n  @EndUserText: { label: 'Loyalty Points', quickInfo: 'Loyalty Points' }\r\n  @UI.textArrangement: #TEXT_ONLY\r\n  LoyaltyPoints;\r\n  @UI: { lineItem:       [ { label: 'Points Valid Until', position: 70, importance: #HIGH } ] ,\r\n          identification: [{ label: 'Points Valid Until', position: 70 }]  }\r\n  @EndUserText: { label: 'Points Valid Until', quickInfo: 'Points Valid Until' }\r\n  PointExpiryDate;\r\n\r\n  @UI.hidden: true\r\n  CreatedBy;\r\n\r\n  @UI.hidden: true\r\n  LastChangedat;\r\n\r\n  @UI.hidden: true\r\n  LastChangedby;\r\n\r\n}"
