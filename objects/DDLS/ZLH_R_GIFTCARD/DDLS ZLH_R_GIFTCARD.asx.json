    "SOURCE":"@AccessControl.authorizationCheck: #NOT_REQUIRED\r\n@EndUserText.label: 'Gift Card  Details'\r\n@Metadata.ignorePropagatedAnnotations: true\r\ndefine view entity ZLH_R_GIFTCARD as select from zlh_giftcard\r\nassociation [1..*] to ZLH_I_Giftcard_status_TEXT as _StatusText on _StatusText.domain_name = 'ZLH_GIFTCARD_STATUS'\r\n                                               and $projection.GiftcardStatus = _StatusText.value_low\r\nassociation [1..1] to I_BusinessUserBasic as _CreatedByUser \r\n    on $projection.CreatedBy = _CreatedByUser.UserID\r\nassociation to parent ZLH_R_BusinessPartner as _BP on $projection.BusinessPartner = _BP.SoldToParty\r\n{\r\n  key giftcardnumber as Giftcardnumber,\r\n  sap_description as SapDescription,\r\n  business_partner as BusinessPartner,\r\n  @Semantics.amount.currencyCode: 'GiftcardCurrency'\r\n  giftcard_value as GiftcardValue,\r\n  @Semantics.amount.currencyCode: 'GiftcardCurrency'\r\n  giftcard_balance as GiftcardBalance,\r\n  giftcard_currency as GiftcardCurrency,\r\n  giftcard_status as GiftcardStatus,\r\n  @Semantics.user.createdBy\r\n  created_by as CreatedBy,\r\n  created_on as CreatedOn,\r\n  last_changedat as LastChangedat,\r\n  @Semantics.user.lastChangedBy\r\n  last_changedby as LastChangedby,\r\n  _StatusText,\r\n  _CreatedByUser,\r\n  _BP \r\n}\r\n/*+[internal] {\n\"BASEINFO\":\n{\n\"FROM\":\n[\n\"ZLH_GIFTCARD\"\n],\n\"ASSOCIATED\":\n[\n\"I_BUSINESSUSERBASIC\",\n\"ZLH_I_GIFTCARD_STATUS_TEXT\",\n\"ZLH_R_BUSINESSPARTNER\"\n],\n\"BASE\":\n[],\n\"ANNO_REF\":\n[],\n\"SCALAR_FUNCTION\":\n[],\n\"VERSION\":0,\n\"ANNOREF_EVALUATION_ERROR\":\"\"\n}\n}*/",
