    "SOURCE":"@EndUserText.label: 'Loyalty Hub Category Header Maintenance'\r\n@AccessControl.authorizationCheck: #NOT_REQUIRED\r\ndefine root view entity ZLH_R_CATEGORY_MAINT\r\n  as select from I_Language\r\n    left outer join I_CstmBizConfignLastChgd on I_CstmBizConfignLastChgd.ViewEntityName = 'ZLH_R_CATEGORY_HDR'\r\n  association [0..*] to I_ABAPTransportRequestText as _ABAPTransportRequestText on $projection.TransportRequestID = _ABAPTransportRequestText.TransportRequestID\r\n  composition [0..*] of ZLH_R_CATEGORY_HDR as _CategoryHeader\r\n{\r\n  key 1 as SingletonID,\r\n  _CategoryHeader,\r\n  I_CstmBizConfignLastChgd.LastChangedDateTime as LastChangedAtMax,\r\n  cast( '' as SXCO_TRANSPORT) as TransportRequestID,\r\n  _ABAPTransportRequestText\r\n}\r\nwhere I_Language.Language = $session.system_language\r\n/*+[internal] {\n\"BASEINFO\":\n{\n\"FROM\":\n[\n\"I_CSTMBIZCONFIGNLASTCHGD\",\n\"I_LANGUAGE\"\n],\n\"ASSOCIATED\":\n[\n\"I_ABAPTRANSPORTREQUESTTEXT\",\n\"ZLH_R_CATEGORY_HDR\"\n],\n\"BASE\":\n[],\n\"ANNO_REF\":\n[],\n\"SCALAR_FUNCTION\":\n[],\n\"VERSION\":0,\n\"ANNOREF_EVALUATION_ERROR\":\"\"\n}\n}*/",
